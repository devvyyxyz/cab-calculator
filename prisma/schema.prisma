// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transaction {
  id          String   @id @default(cuid())
  discordId   String?
  discordName String?
  yourOffer   String   // JSON encoded offer
  theirOffer  String   // JSON encoded offer
  yourTotal   Float
  theirTotal  Float
  verdict     String
  createdAt   DateTime @default(now())

  @@index([discordId])
  @@index([createdAt])
}

model Species {
  id            String   @id @default(cuid())
  name          String   @unique
  fullName      String
  shortenedName String
  icon          String
  attack        Float
  health        Float
  speed         Float
  rarity        Float
  isExclusive   Boolean  @default(false)
  exists        Int?
  spawnWorld    Int?
  spawnZone     Int?
  demand        String   @default("medium") // "very-low" | "low" | "medium" | "high"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([name])
  @@index([rarity])
  @@index([demand])
}

model BagItem {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  icon        String
  demand      String   @default("medium") // "very-low" | "low" | "medium" | "high"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([demand])
}

model Moveset {
  id             String   @id @default(cuid())
  name           String   @unique
  energy         Int
  type           String   // "damage" | "healing" | "utility"
  demonExclusive Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([name])
}

model Hoverboard {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  icon        String
  speed       Float
  demand      String   @default("medium") // "very-low" | "low" | "medium" | "high"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

model NewsPost {
  id          String    @id @default(cuid())
  title       String
  description String
  category    String    @default("news") // "news" | "updates" | "leaks"
  channel     String
  date        String
  icon        String?
  gradient    String?
  border      String?
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([category])
  @@index([date])
}
